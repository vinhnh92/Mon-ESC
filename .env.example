# Sao chép thành .env (trình cài sẽ tự làm nếu chưa có) rồi sửa các giá trị bên dưới.

# --- Website ---
SITE_TITLE=Nhôm Định Hình
SITE_TAGLINE=Nhôm định hình cắt – khoan – taro theo yêu cầu
# Thư mục trong htdocs (XAMPP) / www (Laragon). Web sẽ chạy tại http://localhost/<SITE_FOLDER>
SITE_FOLDER=nhomdinhhinh

ADMIN_USER=admin
ADMIN_PASSWORD=doi-mat-khau-nay
ADMIN_EMAIL=admin@example.com

# --- Database (XAMPP / Laragon mặc định: root, mật khẩu trống) ---
DB_NAME=nhomdinhhinh
DB_USER=root
DB_PASSWORD=
DB_PORT=3306

# Nếu XAMPP / Laragon không nằm ở C:\ hoặc D:\, ghi đường dẫn vào đây, ví dụ: STACK_DIR=E:\xampp
STACK_DIR=

# --- Cửa hàng ---
STORE_PHONE=0900000000
STORE_ZALO=0900000000
STORE_ADDRESS=123 Đường ABC
STORE_CITY=Hồ Chí Minh
BANK_NAME=Vietcombank
BANK_ACCOUNT=0123456789
BANK_HOLDER=NGUYEN VAN A

# 1 = tạo sản phẩm mẫu (nhôm 2020–4545, phụ kiện)
SEED_DEMO=1
